{% assign post = site.pages | where: "url", "/feed-test/hello.html" | first %}{% capture img %}{{ '/feed-test/ibm.png' | absolute_url }}{% endcapture %}<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>Ramón Astudillo · feed test</title>
    <link>{{ '/' | absolute_url }}</link>
    <description>Test RSS feed for checking Slack /feed previews.</description>
    <language>en</language>
    <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml"/>
    <image>
      <url>{{ img }}</url>
      <title>Ramón Astudillo · feed test</title>
      <link>{{ '/' | absolute_url }}</link>
    </image>
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
